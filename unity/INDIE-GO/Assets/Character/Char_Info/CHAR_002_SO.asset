  passive_Name: "\uB3C4\uC0AC\uC758 \uBD80\uC801"
  passive_Desc: "\uB9D0\uC774 \uD310\uC5D0 \uC62C\uB77C\uAC00\uBA74 \uAC00\uC7A5 \uAC00\uAE4C\uC6B4 \uC544\uAD70\uC5D0\uAC8C \uC218\uD638\uC758 \uBD80\uC801\uC744 \uC900\uB2E4. \uD574\uB2F9 \uC544\uAD70\uC740 \uB2E4\uC74C \uC790\uC2E0\uC758 \uD134 \uC2DC\uC791\uAE4C\uC9C0 \uC7A1\uAE30\uC640 \uD574\uB85C\uC6B4 \uC0C1\uD0DC\uC774\uC0C1\uC744 \uB9C9\uB294\uB2E4. \uB9AC\uD0C0\uC774\uC5B4 \uD6C4 \uB2E4\uC2DC \uD310\uC5D0 \uC62C\uB77C\uC624\uBA74 \uC7AC\uC0AC\uC6A9\uD560 \uC218 \uC788\uB2E4."
